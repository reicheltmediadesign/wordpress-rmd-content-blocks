msgid "RMD Content Blocks requires PHP %1$s or newer. This site runs PHP %2$s, so the plugin stays inactive."
msgstr "RMD Content Blocks benötigt PHP %1$s oder neuer. Diese Website läuft mit PHP %2$s, daher bleibt das Plugin inaktiv."

msgid "Post %1$d: %2$s"
msgstr "Beitrag %1$d: %2$s"

msgid "Surface: %s"
msgstr "Fläche: %s"

msgid "%d content still uses blocks that RMD Content Blocks replaces."
msgid_plural "%d contents still use blocks that RMD Content Blocks replaces."
msgstr[0] "%d Inhalt verwendet noch Blöcke, die RMD Content Blocks ersetzt."
msgstr[1] "%d Inhalte verwenden noch Blöcke, die RMD Content Blocks ersetzt."

msgid "%d block widget"
msgid_plural "%d block widgets"
msgstr[0] "%d Block-Widget"
msgstr[1] "%d Block-Widgets"

msgid "Content blocks"
msgstr "Inhaltsblöcke"

msgid "Migrate now"
msgstr "Jetzt umstellen"

msgid "Sorry, you are not allowed to access this page."
msgstr "Sie haben leider keine Berechtigung, auf diese Seite zuzugreifen."

msgid "Migrated %1$d blocks in %2$d posts and %3$d widgets."
msgstr "%1$d Blöcke in %2$d Beiträgen und %3$d Widgets umgestellt."

msgid "Replaces blocks of the theme with the blocks of RMD Content Blocks. Settings and texts of the blocks are taken over; the look comes from the plugin and the theme afterwards."
msgstr "Ersetzt Blöcke des Themes durch die Blöcke von RMD Content Blocks. Einstellungen und Texte der Blöcke werden übernommen; das Aussehen kommt danach aus Plugin und Theme."

msgid "Replaced blocks:"
msgstr "Ersetzte Blöcke:"

msgid "No content uses these blocks any more. Nothing to do."
msgstr "Kein Inhalt verwendet diese Blöcke mehr. Es ist nichts zu tun."

msgid "Contents with these blocks:"
msgstr "Inhalte mit diesen Blöcken:"

msgid "Each post is saved once, so its previous version stays available as a revision."
msgstr "Jeder Beitrag wird einmal gespeichert, die bisherige Fassung bleibt als Revision erhalten."

msgid "Migrate blocks now"
msgstr "Blöcke jetzt umstellen"

msgid "Straight (full width)"
msgstr "Gerade (volle Breite)"

msgid "Arch (curved edges, full width)"
msgstr "Bogen (gewölbte Kanten, volle Breite)"

msgid "Round (inset, rounded corners)"
msgstr "Rund (eingerückt, runde Ecken)"

msgid "Learn more"
msgstr "Mehr erfahren"

msgid "Advertisement · affiliate link*"
msgstr "Werbung · Affiliate-Link*"

msgid "* Links marked as affiliate links are commission links. If you buy through such a link, we receive a small commission. The price stays the same for you."
msgstr "* Die als Affiliate-Link gekennzeichneten Links sind Provisions-Links. Wenn Sie über einen solchen Link kaufen, erhalten wir eine kleine Provision. Am Preis ändert sich für Sie nichts."

