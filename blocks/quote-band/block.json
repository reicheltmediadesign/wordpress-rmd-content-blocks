{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "rmd/quote-band",
	"title": "Quote band",
	"category": "design",
	"icon": "format-quote",
	"description": "One sentence in large, light type on a coloured band across the full width.",
	"keywords": [ "quote", "claim", "statement" ],
	"textdomain": "rmd-content-blocks",
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		},
		"text": {
			"type": "string",
			"default": ""
		},
		"author": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ]
	},
	"editorScript": "file:./index.js",
	"style": "rmd-content-blocks",
	"editorStyle": "rmd-content-blocks-editor",
	"render": "file:./render.php"
}
